{
  "name": "bloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "server:build": "node server/build.mjs",
    "server:dev": "node server/build.mjs && DB_PATH=./data/dev.sqlite ALLOWED_ORIGINS=* node server/dist/server.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
